---
import { t, getLocalizedPath, getAlternateLang, getPagePath } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const altLang = getAlternateLang(lang);
const pagePath = getPagePath(Astro.url);

const links = [
  { label: t(lang, "nav.home"), href: getLocalizedPath(lang, "/") },
  { label: t(lang, "nav.about"), href: getLocalizedPath(lang, "/about/") },
  { label: t(lang, "nav.projects"), href: getLocalizedPath(lang, "/projects/") },
  { label: t(lang, "nav.notes"), href: getLocalizedPath(lang, "/notes/") },
  { label: t(lang, "nav.contact"), href: getLocalizedPath(lang, "/contact/") },
];
---

<nav class="navbar glass" id="navbar">
  <div class="nav-inner container">
    <a href={getLocalizedPath(lang, "/")} class="nav-logo">
      <span class="gradient-text">GF</span>
    </a>

    <div class="lang-switch">
      <a
        href={getLocalizedPath("it", pagePath)}
        class:list={["lang-btn", { active: lang === "it" }]}
        aria-label="Italiano"
      >IT</a>
      <span class="lang-sep">|</span>
      <a
        href={getLocalizedPath("en", pagePath)}
        class:list={["lang-btn", { active: lang === "en" }]}
        aria-label="English"
      >EN</a>
    </div>

    <ul class="nav-links" id="nav-links">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[{ active: currentPath === link.href || currentPath === link.href.slice(0, -1) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu">
      <span class="hamburger"></span>
    </button>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    height: 64px;
  }

  .nav-logo {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
    flex: 1;
    justify-content: center;
  }

  .nav-links a {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: var(--transition);
    text-decoration: none;
  }

  .nav-links a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-links a.active {
    color: var(--accent-light);
    background: rgba(6, 182, 212, 0.1);
  }

  /* Lang switch — right on desktop */
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-heading);
    order: 3; /* push after nav-links on desktop */
    flex-shrink: 0;
  }

  .lang-btn {
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    color: var(--text-muted);
    text-decoration: none;
    transition: var(--transition);
  }

  .lang-btn:hover {
    color: #fff;
  }

  .lang-btn.active {
    color: var(--accent-light);
    background: rgba(6, 182, 212, 0.1);
  }

  .lang-sep {
    color: var(--text-muted);
    font-weight: 300;
    user-select: none;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1010;
    flex-shrink: 0;
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: var(--transition);
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: "";
    position: absolute;
    left: 0;
  }
  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }

  .nav-toggle.open .hamburger {
    background: transparent;
  }
  .nav-toggle.open .hamburger::before {
    top: 0;
    transform: rotate(45deg);
  }
  .nav-toggle.open .hamburger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* ========================
     MOBILE
     ======================== */
  @media (max-width: 768px) {
    .nav-inner {
      justify-content: space-between;
    }

    /* Lang switch moves next to logo */
    .lang-switch {
      order: 0;
      margin-left: 2rem;
      margin-right: auto; /* push hamburger to far right */
    }

    .nav-toggle {
      display: block;
    }

    /* Fullscreen opaque overlay */
    .nav-links {
      position: right;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
      padding-left: 0;
      padding-right: 0;
      margin-top: 10rem;
      margin-left: 5rem;
      border: 1px solid rgb(0, 0, 70);;
      border-radius: 1rem;
      z-index: 1005;
      flex-direction: column;
      align-items: center;
      justify-content: right;
      gap: 0.75rem;
      background: rgb(0, 0, 70);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .nav-links.open {
      opacity: 1;
      pointer-events: all;
    }

    .nav-links a {
      font-size: 0.95rem;
      padding: 0.3rem 0.5rem;
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const links = document.getElementById("nav-links");

  toggle?.addEventListener("click", () => {
    toggle.classList.toggle("open");
    links?.classList.toggle("open");
  });

  links?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      toggle?.classList.remove("open");
      links?.classList.remove("open");
    });
  });
</script>
