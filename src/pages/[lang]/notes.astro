---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { t, getLangPaths } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";

export function getStaticPaths() {
  return getLangPaths();
}

const lang = Astro.params.lang as Lang;
---

<Layout title={t(lang, "notes.title")} lang={lang}>
  <section class="section page-section">
    <div class="container">
      <SectionHeading title={t(lang, "notes.heading")} subtitle={t(lang, "notes.subtitle")} />
      <div class="coming-soon glass">
        <div class="cs-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"></path></svg>
        </div>
        <h3>{t(lang, "notes.coming")}</h3>
        <p>{t(lang, "notes.coming.desc")}</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-section { padding-top: calc(64px + 4rem); min-height: 80vh; }
  .coming-soon { text-align: center; padding: 4rem 2rem; border-radius: var(--radius-lg); max-width: 500px; }
  .cs-icon { color: var(--accent); margin-bottom: 1.5rem; animation: float 4s ease-in-out infinite; }
  .coming-soon h3 { font-size: 1.5rem; margin-bottom: 0.75rem; background: var(--gradient-text); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .coming-soon p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.7; }
</style>
