---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SkillBadge from "../../components/SkillBadge.astro";
import { t, getLangPaths } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";
import { skills as skillKeys } from "../../data/profile";

export function getStaticPaths() {
  return getLangPaths();
}

const lang = Astro.params.lang as Lang;

const skills = Object.fromEntries(
  Object.entries(skillKeys).map(([key, items]) => [t(lang, key), items]),
);

const education = [
  {
    period: t(lang, "about.edu.1.period"),
    title: t(lang, "about.edu.1.title"),
    institution: t(lang, "about.edu.1.institution"),
    description: t(lang, "about.edu.1.desc"),
  },
  {
    period: t(lang, "about.edu.2.period"),
    title: t(lang, "about.edu.2.title"),
    institution: t(lang, "about.edu.2.institution"),
    description: t(lang, "about.edu.2.desc"),
  },
];
---

<Layout title={t(lang, "about.title")} lang={lang}>
  <section class="section page-section">
    <div class="container">
      <SectionHeading title={t(lang, "about.heading")} subtitle={t(lang, "about.heading.sub")} />
      <div class="about-bio">
        <p set:html={t(lang, "about.bio.1")} />
        <p>{t(lang, "about.bio.2")}</p>
        <p>{t(lang, "about.bio.3")}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading title={t(lang, "about.skills.title")} subtitle={t(lang, "about.skills.subtitle")} />
      <div class="skills-grid">
        {Object.entries(skills).map(([category, items]) => (
          <div class="skill-category">
            <h3 class="skill-category-title">{category}</h3>
            <div class="skill-list">
              {items.map((skill) => <SkillBadge name={skill} />)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading title={t(lang, "about.edu.title")} subtitle={t(lang, "about.edu.subtitle")} />
      <div class="timeline">
        {education.map((edu) => (
          <div class="timeline-item glass">
            <span class="timeline-period">{edu.period}</span>
            <h3 class="timeline-title">{edu.title}</h3>
            <p class="timeline-institution">{edu.institution}</p>
            <p class="timeline-desc">{edu.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-section { padding-top: calc(64px + 4rem); }
  .about-bio { max-width: 700px; display: flex; flex-direction: column; gap: 1rem; }
  .about-bio p { font-size: 1.05rem; line-height: 1.9; }
  .about-bio :global(strong) { color: #fff; font-weight: 600; }
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
  .skill-category-title { font-size: 1rem; color: var(--accent-light); margin-bottom: 1rem; font-weight: 600; }
  .skill-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .timeline { display: flex; flex-direction: column; gap: 1.5rem; max-width: 700px; }
  .timeline-item { padding: 1.75rem; border-radius: var(--radius-lg); position: relative; transition: var(--transition); }
  .timeline-item:hover { border-color: rgba(6, 182, 212, 0.15); transform: translateX(4px); }
  .timeline-item::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--gradient); border-radius: 3px 0 0 3px; }
  .timeline-period { font-size: 0.8rem; color: var(--accent-light); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
  .timeline-title { margin: 0.5rem 0 0.25rem; font-size: 1.15rem; }
  .timeline-institution { color: var(--text-secondary); font-size: 0.95rem; font-weight: 500; margin-bottom: 0.5rem; }
  .timeline-desc { font-size: 0.9rem; color: var(--text-muted); line-height: 1.7; }
</style>
