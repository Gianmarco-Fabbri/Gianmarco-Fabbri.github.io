---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { t, getLangPaths } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";
import { contacts } from "../../data/profile";

export function getStaticPaths() {
  return getLangPaths();
}

const lang = Astro.params.lang as Lang;
---

<Layout title={t(lang, "contact.title")} lang={lang}>
  <section class="section page-section">
    <div class="container">
      <SectionHeading title={t(lang, "contact.heading")} subtitle={t(lang, "contact.subtitle")} />
      <p class="contact-intro">{t(lang, "contact.intro")}</p>
      <div class="contact-grid">
        {contacts.map((c) => (
          <a href={c.href} target="_blank" rel="noopener noreferrer" class="contact-card glass">
            <div class="contact-icon" set:html={c.icon} />
            <div class="contact-info">
              <span class="contact-label">{c.label}</span>
              <span class="contact-value">{c.value}</span>
            </div>
            <svg class="contact-arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-section { padding-top: calc(64px + 4rem); min-height: 80vh; }
  .contact-intro { max-width: 550px; margin-bottom: 2.5rem; font-size: 1.05rem; }
  .contact-grid { display: grid; gap: 1rem; max-width: 600px; }
  .contact-card { display: flex; align-items: center; gap: 1.25rem; padding: 1.5rem 1.75rem; border-radius: var(--radius-lg); text-decoration: none; transition: var(--transition); overflow: hidden; max-width: 100%; }
  .contact-card:hover { transform: translateY(-2px); border-color: rgba(6, 182, 212, 0.2); box-shadow: 0 8px 30px rgba(6, 182, 212, 0.08); }
  .contact-icon { color: var(--accent); flex-shrink: 0; }
  .contact-info { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .contact-label { font-size: 1rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
  .contact-value { color: #fff; font-weight: 400; font-size: 0.75rem; margin-top: 0.15rem; overflow: hidden; text-overflow: ellipsis; word-break: break-all; }
  .contact-arrow { color: var(--text-muted); flex-shrink: 0; transition: var(--transition); }
  .contact-card:hover .contact-arrow { color: var(--accent-light); transform: translate(2px, -2px); }
</style>
